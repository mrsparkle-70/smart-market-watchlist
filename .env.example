# --- App ---
ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Persistence ---
# Local dev default: SQLite. Docker Compose overrides this with Postgres.
DATABASE_URL=sqlite:///./watchlist.db
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=generate-a-long-random-string-for-production

# --- Market data provider ---
# mock     = deterministic simulator, no key needed (default, demo-ready)
# finnhub  = real provider, needs a FINNHUB key
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=
BENCHMARK_SYMBOL=SPY

# --- Background pipeline ---
POLL_INTERVAL_SECONDS=300
PIPELINE_ENABLED=true

# --- Optional LLM (Groq/OpenAI-compatible). Leave empty to use deterministic templates.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# --- Frontend ---
NEXT_PUBLIC_API_URL=
API_PROXY_URL=http://localhost:8000
